{
  "editor.rulers": [120],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true,
    "source.fixAll.markdownlint": true
  },
  "eslint.alwaysShowStatus": true,
  "eslint.validate": [ "typescript", "javascript", "html" ],
  "yaml.validate": true,
  "search.exclude": {
    "**/.history": true,
    "**/documentation": true,
    "**/node_modules": true,
    "**/coverage": true
  }
}
