{
  "name": "@mercadona/archetype",
  "author": "Mercadona",
  "version": "0.0.0",
  "description": "",
  "engines": {
    "node": "16.15.0",
    "npm": "8.5.5"
  },
  "contributors": [
    {
      "name": "Mercadona Angular Framework (FWKA), based on Archetype 1.0.X",
      "url": "https://confluence.mercadona.com/pages/viewpage.action?pageId=906283684"
    }
  ],
  "scripts": {
    "ng": "ng",
    "init": "npm install && ng generate @mercadona/schematics:language && ng generate @mercadona/schematics:login",
    "postinstall": "husky install",
    "start": "ng serve",
    "start:pro": "ng serve --configuration production",
    "start:hmr": "ng serve --hmr",
    "start:doc": "compodoc -s",
    "build": "ng build",
    "build:pro": "ng build --source-map=true --stats-json",
    "build:doc": "compodoc -p tsconfig.doc.json",
    "build:api": "ng-swagger-gen --config swagger/swagger.config.json",
    "test": "ng test --browsers Chrome",
    "test:safari": "ng test --browsers Safari",
    "test:coverage": "ng test --watch=false --browsers Chrome",
    "test:ci:local": "node --version && ng test --karma-config=karma-ci.conf.js --no-progress --watch=false --browsers ChromeHeadlessCI",
    "test:ci": "node --version && ng test --karma-config=karma-ci.conf.js --no-progress --watch=false --browsers GridChrome",
    "e2e": "ng e2e",
    "audit": "npm audit",
    "lint": "ng lint",
    "lint:prettier": "prettier --check --ignore-unknown .",
    "lint:fix": "prettier --write --ignore-unknown . && ng lint --fix",
    "lint:staged": "lint-staged",
    "lint:staged:prettier:fix": "lint-staged --config .lintstagedrc-prettier-fix.json",
    "lint:staged:eslint:fix": "lint-staged --config .lintstagedrc-eslint-fix.json",
    "lint:staged:fix": "npm run lint:staged:prettier:fix && npm run lint:staged:eslint:fix",
    "analyze:source-map": "source-map-explorer ./dist/*.js",
    "analyze:webpack-bundle": "webpack-bundle-analyzer ./dist/stats.json",
    "add:login": "ng generate @mercadona/schematics:login",
    "add:language": "ng generate @mercadona/schematics:language",
    "add:page": "ng generate @mercadona/schematics:page",
    "add:component": "ng generate @mercadona/schematics:component",
    "add:pipe": "ng generate @mercadona/schematics:pipe",
    "add:directive": "ng generate @mercadona/schematics:directive",
    "add:service": "ng generate @mercadona/schematics:service",
    "add:model": "ng generate @mercadona/schematics:model",
    "add:interface": "ng generate @mercadona/schematics:interface"
  },
  "dependencies": {
    "@angular/animations": "14.1.0",
    "@angular/cdk": "14.1.0",
    "@angular/common": "14.1.0",
    "@angular/compiler": "14.1.0",
    "@angular/core": "14.1.0",
    "@angular/forms": "14.1.0",
    "@angular/platform-browser": "14.1.0",
    "@angular/platform-browser-dynamic": "14.1.0",
    "@angular/router": "14.1.0",
    "@mercadona/components": "file:../mercadona-fwk-front/dist/libs/components/mercadona-components-0.0.0.tgz",
    "@mercadona/core": "file:../mercadona-fwk-front/dist/libs/core/mercadona-core-0.0.0.tgz",
    "@mercadona/core-ui": "file:../mercadona-fwk-front/dist/libs/core-ui/mercadona-core-ui-0.0.0.tgz",
    "@mercadona/icons": "file:../mercadona-fwk-front/dist/libs/icons/mercadona-icons-0.0.0.tgz",
    "@mercadona/styles": "file:../mercadona-fwk-front/dist/libs/styles/mercadona-styles-0.0.0.tgz",
    "rxjs": "7.5.6",
    "tslib": "2.4.0",
    "zone.js": "0.11.7"
  },
  "devDependencies": {
    "@aduh95/viz.js": "3.7.0",
    "@angular-devkit/build-angular": "14.1.0",
    "@angular-eslint/builder": "14.0.2",
    "@angular-eslint/eslint-plugin": "14.0.2",
    "@angular-eslint/eslint-plugin-template": "14.0.2",
    "@angular-eslint/template-parser": "14.0.2",
    "@angular/cli": "14.1.0",
    "@angular/compiler-cli": "14.1.0",
    "@commitlint/cli": "17.0.3",
    "@commitlint/config-conventional": "17.0.3",
    "@compodoc/compodoc": "1.1.19",
    "@mercadona/eslint-plugin": "file:../mercadona-fwk-front/dist/libs/eslint-plugin/mercadona-eslint-plugin-0.0.0.tgz",
    "@mercadona/schematics": "file:../mercadona-fwk-front/dist/libs/schematics/mercadona-schematics-0.0.0.tgz",
    "@types/jasmine": "4.0.3",
    "@types/jasminewd2": "2.0.10",
    "@types/node": "16.11.45",
    "@typescript-eslint/eslint-plugin": "5.30.7",
    "@typescript-eslint/parser": "5.30.7",
    "eslint": "8.20.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-deprecation": "1.3.2",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-jasmine": "4.1.3",
    "eslint-plugin-jsdoc": "39.3.3",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "husky": "8.0.1",
    "jasmine-core": "4.3.0",
    "jasmine-spec-reporter": "7.0.0",
    "jasminewd2": "2.2.0",
    "karma": "6.4.0",
    "karma-webdriver-launcher": "1.0.8",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.0.0",
    "karma-safari-launcher": "1.0.0",
    "karma-spec-reporter": "0.0.34",
    "lint-staged": "13.0.3",
    "ng-swagger-gen": "2.3.1",
    "prettier": "2.7.1",
    "protractor": "7.0.0",
    "source-map-explorer": "2.5.2",
    "ts-node": "10.9.1",
    "typescript": "4.7.4",
    "webpack-bundle-analyzer": "4.5.0"
  }
}
