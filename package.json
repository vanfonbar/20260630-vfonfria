{
  "name": "@mercadona-fwk-front/arquetype",
  "version": "0.0.0",
  "description": "",
  "engines": {
    "node": "12.16.3",
    "npm": "6.14.4"
  },
  "contributors": [
    {
      "name": "Arquitectura FWK Front Mercadona, basado en el Arquetype 1.0.0-beta.13",
      "url": "https://confluence.mercadona.com/pages/viewpage.action?pageId=906283684"
    }
  ],
  "scripts": {
    "ng": "ng",
    "init:install": "npm install && npm run ng -- add @mercadona-fwk-front/schematics && npm run ng -- generate @mercadona-fwk-front/schematics:login",
    "start": "ng serve",
    "start:pro": "ng serve --prod",
    "start:hmr": "ng serve --hmr",
    "build": "ng build",
    "build:pro": "ng build --prod --source-map=true",
    "build:dev": "ng build --prod --source-map=true --stats-json",
    "test": "ng test --watch --code-coverage=true --browsers Chrome",
    "test:safari": "ng test --watch --code-coverage=true --browsers Safari",
    "test:coverage": "ng test --watch=false --code-coverage=true --browsers Chrome",
    "test:ci": "ng test --karma-config=karma-ci.conf.js --no-progress --code-coverage=true --watch=false --browsers ChromeHeadlessCI",
    "e2e": "ng e2e",
    "audit": "npm audit --production",
    "lint": "ng lint && npx prettier --check \"**/*.{ts,js,html}\" && npx stylelint -s scss \"**/*.scss\"",
    "lint:fix": "ng lint --fix && npx prettier --write \"**/*.{ts,js,html}\" && npx stylelint -s scss --fix \"**/*.scss\"",
    "generate:doc": "compodoc -p tsconfig.json",
    "generate:api": "ng-swagger-gen --config swagger/swagger.config.json",
    "analyze:source-map": "source-map-explorer ./dist/*.js",
    "analyze:webpack-bundle": "webpack-bundle-analyzer ./dist/stats.json"
  },
  "dependencies": {
    "@angular/animations": "11.2.1",
    "@angular/cdk": "11.2.1",
    "@angular/common": "11.2.1",
    "@angular/compiler": "11.2.1",
    "@angular/core": "11.2.1",
    "@angular/forms": "11.2.1",
    "@angular/platform-browser": "11.2.1",
    "@angular/platform-browser-dynamic": "11.2.1",
    "@angular/router": "11.2.1",
    "@mercadona-fwk-front/components": "file:../mercadona-fwk-front/dist/libs/components/mercadona-fwk-front-components-0.0.0.tgz",
    "@mercadona-fwk-front/core": "file:../mercadona-fwk-front/dist/libs/core/mercadona-fwk-front-core-0.0.0.tgz",
    "@mercadona-fwk-front/core-ui": "file:../mercadona-fwk-front/dist/libs/core-ui/mercadona-fwk-front-core-ui-0.0.0.tgz",
    "@mercadona-fwk-front/icons": "file:../mercadona-fwk-front/dist/libs/icons/mercadona-fwk-front-icons-0.0.0.tgz",
    "@mercadona-fwk-front/styles": "file:../mercadona-fwk-front/dist/libs/styles/mercadona-fwk-front-styles-0.0.0.tgz",
    "bootstrap": "4.5.3",
    "rxjs": "6.6.3",
    "tslib": "2.1.0",
    "zone.js": "0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "0.1102.1",
    "@angular-eslint/builder": "2.1.0",
    "@angular-eslint/eslint-plugin": "2.1.0",
    "@angular-eslint/eslint-plugin-template": "2.1.0",
    "@angular-eslint/template-parser": "2.1.0",
    "@angular/cli": "11.2.1",
    "@angular/compiler-cli": "11.2.1",
    "@compodoc/compodoc": "1.1.11",
    "@mercadona-fwk-front/schematics": "file:../mercadona-fwk-front/dist/libs/schematics/mercadona-fwk-front-schematics-0.0.0.tgz",
    "@types/jasmine": "3.6.3",
    "@types/jasminewd2": "2.0.8",
    "@types/node": "12.19.11",
    "@typescript-eslint/eslint-plugin": "4.22.0",
    "@typescript-eslint/parser": "4.22.0",
    "codelyzer": "6.0.1",
    "eslint": "7.24.0",
    "eslint-config-prettier": "8.2.0",
    "eslint-plugin-deprecation": "1.2.0",
    "eslint-plugin-import": "2.22.1",
    "eslint-plugin-jsdoc": "32.3.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "3.4.0",
    "jasmine-core": "3.6.0",
    "jasmine-spec-reporter": "6.0.0",
    "karma": "6.1.1",
    "karma-chrome-launcher": "3.1.0",
    "karma-coverage": "2.0.3",
    "karma-jasmine": "4.0.1",
    "karma-jasmine-html-reporter": "1.5.4",
    "karma-safari-launcher": "1.0.0",
    "karma-spec-reporter": "0.0.32",
    "ng-swagger-gen": "2.3.1",
    "postcss-scss": "3.0.5",
    "prettier": "2.2.1",
    "prettier-eslint": "12.0.0",
    "protractor": "7.0.0",
    "source-map-explorer": "2.4.2",
    "stylelint": "13.13.1",
    "stylelint-config-recommended-scss": "4.2.0",
    "stylelint-scss": "3.19.0",
    "ts-node": "9.1.1",
    "typescript": "4.0.5",
    "webpack-bundle-analyzer": "3.8.0"
  }
}
