{
  "name": "@mercadona/archetype",
  "author": "Mercadona",
  "version": "4.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "contributors": [
    {
      "name": "Mercadona Angular Framework (FWKA), based on Archetype 4.0.0",
      "url": "https://angular.srv.mercadona.com/"
    }
  ],
  "scripts": {
    "ng": "ng",
    "init": "npm ci && npm run add:language && npm run add:login",
    "postinstall": "env-check !CI && (husky && npm run install:browsers) || exit 0",
    "install:preview": "npm login --registry=https://artifactory.gcp.mercadona.com/artifactory/api/npm/virtual-npm-staging && npm install --registry=https://artifactory.gcp.mercadona.com/artifactory/api/npm/virtual-npm-staging/ --loglevel verbose",
    "start": "ng serve",
    "start:pro": "ng serve --configuration production",
    "start:hmr": "ng serve --hmr",
    "build": "ng build",
    "build:pro": "ng build --source-map=true --stats-json",
    "build:preview": "ng build --configuration=development-preview",
    "test": "ng test --browsers Chrome",
    "test:safari": "ng test --browsers Safari",
    "test:coverage": "ng test --watch=false --browsers Chrome",
    "test:with-coverage": "ng test --watch=false --code-coverage --browsers Chrome",
    "test:local": "node --version && ng test --karma-config=karma.conf.js --no-progress --watch=false --browsers ChromeHeadlessCI",
    "test:ci": "node --version && ng test --karma-config=karma-ci.conf.js --no-progress --watch=false --browsers ChromeHeadlessCI",
    "audit": "npm audit",
    "lint": "ng lint",
    "stylelint": "stylelint '**/*.{css,scss}'",
    "lint:errors": "ng lint --quiet",
    "lint:prettier": "prettier --check --ignore-unknown .",
    "lint:fix": "prettier --write --ignore-unknown . && ng lint --fix",
    "stylelint:fix": "npm run stylelint -- --fix",
    "stylelint:errors": "npm run stylelint -- --quiet",
    "lint:staged": "lint-staged",
    "lint:staged:prettier:fix": "lint-staged --config .lintstagedrc-prettier-fix.js",
    "lint:staged:eslint:fix": "lint-staged --config .lintstagedrc-eslint-fix.js",
    "lint:staged:stylelint:fix": "lint-staged --config .lintstagedrc-stylelint-fix.js",
    "lint:staged:fix": "npm run lint:staged:prettier:fix && npm run lint:staged:eslint:fix",
    "analyze:source-map": "source-map-explorer ./dist/*.js",
    "analyze:webpack-bundle": "webpack-bundle-analyzer ./dist/stats.json",
    "add:login": "ng generate @mercadona/schematics:login",
    "add:language": "ng generate @mercadona/schematics:language",
    "add:page": "ng generate @mercadona/schematics:page",
    "add:component": "ng generate @mercadona/schematics:component",
    "add:pipe": "ng generate @mercadona/schematics:pipe",
    "add:directive": "ng generate @mercadona/schematics:directive",
    "add:service": "ng generate @mercadona/schematics:service",
    "add:model": "ng generate @mercadona/schematics:model",
    "add:interface": "ng generate @mercadona/schematics:interface",
    "add:icons": "ng generate @mercadona/schematics:icons",
    "add:setup-icons": "ng generate @mercadona/schematics:setup-icons",
    "add:pwa": "ng generate @mercadona/schematics:pwa",
    "add:swagger": "ng generate @mercadona/schematics:swagger --config swagger/config.json",
    "add:auth-provider": "ng generate @mercadona/schematics:auth-provider",
    "add:idp-selector": "ng generate @mercadona/schematics:idp-selector",
    "add:module-to-provider": "ng generate @mercadona/schematics:module-to-provider && npm run lint:fix",
    "add:module-to-standalone": "ng generate @mercadona/schematics:module-to-standalone && npm run lint:fix",
    "add:migrate-modules": "npm run add:module-to-provider && npm run add:module-to-standalone",
    "add:environment": "ng generate @mercadona/schematics:environment",
    "add:dto": "ng generate @mercadona/schematics:dto",
    "add:mapper": "ng generate @mercadona/schematics:mapper",
    "add:repository": "ng generate @mercadona/schematics:repository",
    "add:use-case": "ng generate @mercadona/schematics:use-case",
    "add:guard": "ng generate @mercadona/schematics:guard",
    "add:interceptor": "ng generate @mercadona/schematics:interceptor",
    "stryker:local": "run-mutants",
    "stryker:ci": "run-mutants --ci",
    "precommit": "npm run lint:staged && npm run test:local",
    "check:versions": "node --version && npm --version && ng version",
    "check:outdated": "npm outdated",
    "install:browsers": "playwright install chromium webkit"
  },
  "dependencies": {
    "@mercadona/components": "4.1.0",
    "@mercadona/core": "4.1.0",
    "@mercadona/core-ui": "4.1.0"
  },
  "devDependencies": {
    "@aduh95/viz.js": "3.7.0",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@mercadona/eslint-plugin": "4.1.0",
    "@mercadona/schematics": "4.1.0",
    "@types/jasmine": "6.0.0",
    "@types/jasminewd2": "2.0.13",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.5.0",
    "husky": "9.1.7",
    "jasmine-core": "6.1.0",
    "jasmine-spec-reporter": "7.0.0",
    "jasminewd2": "2.2.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "karma-safari-launcher": "1.0.0",
    "karma-sonarqube-unit-reporter": "0.0.23",
    "karma-spec-reporter": "0.0.36",
    "lint-staged": "16.4.0",
    "playwright": "1.56.1",
    "source-map-explorer": "2.5.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "webpack-bundle-analyzer": "5.3.0",
    "zone.js": "0.16.1"
  }
}
